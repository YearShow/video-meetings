POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# apps/api (скопируйте в apps/api/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings
JWT_SECRET=change-me
PORT=4000
# Каталог файлов встреч (в docker — volume, статикой не отдаётся)
FILES_DIR=./storage
# Максимальный размер файла в байтах (500 MiB)
MAX_UPLOAD_BYTES=524288000
# Origin web для CORS
WEB_ORIGIN=http://localhost:3000
# Транскрибация mp3/mp4 локальным whisper.cpp (whisper-cli, модель ggml-base.bin; модель в репозитории не хранится).
# Без WHISPER_MODEL_PATH файлы остаются в статусе «Ошибка: Модель Whisper не настроена».
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL_PATH=/path/to/ggml-base.bin
# ffmpeg извлекает звук из mp4 (по умолчанию ffmpeg из PATH)
# FFMPEG_BIN=ffmpeg
# Сколько файлов расшифровывается одновременно (по умолчанию 1)
# TRANSCRIPTION_CONCURRENCY=1
# off отключает возврат незавершённых задач в очередь при старте api (нужно только при нескольких экземплярах на одной БД)
# TRANSCRIPTION_RECOVERY=off

# api в Docker Compose (docker compose up -d --build api): порт на хосте.
# DATABASE_URL, FILES_DIR (volume api_files) и PORT внутри контейнера compose задаёт сам;
# JWT_SECRET обязателен (без него контейнер api не запустится), MAX_UPLOAD_BYTES и WEB_ORIGIN необязательны;
# все берутся из окружения или корневого .env.
API_PORT=4000

# apps/web (необязательно, по умолчанию http://localhost:4000)
# API_URL=http://localhost:4000
# Лимит файла в интерфейсе: должен совпадать с MAX_UPLOAD_BYTES у api (по умолчанию 524288000)
# MAX_UPLOAD_BYTES=524288000
