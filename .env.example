POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# apps/api (скопируйте в apps/api/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings
JWT_SECRET=change-me
PORT=4000
# Каталог файлов встреч (в docker — volume, статикой не отдаётся)
FILES_DIR=./storage
# Максимальный размер файла в байтах (500 MiB)
MAX_UPLOAD_BYTES=524288000
# Origin web для CORS
WEB_ORIGIN=http://localhost:3000

# apps/web (необязательно, по умолчанию http://localhost:4000)
# API_URL=http://localhost:4000
