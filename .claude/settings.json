{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty'); [ -n \"$f\" ] && [ -f \"$f\" ] && PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write --ignore-unknown --log-level warn \"$f\" || true"
          }
        ]
      }
    ]
  }
}
